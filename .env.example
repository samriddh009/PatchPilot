# ==============================================================================
# PatchPilot Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env to version control).
# ==============================================================================

# Server Network Binding (Loopback only for security)
PATCHPILOT_HOST=127.0.0.1
PATCHPILOT_PORT=8000

# SQLite Database Location (defaults to backend/patchpilot.db if omitted)
# PATCHPILOT_DB_PATH=backend/patchpilot.db

# Google Gemini BYOK (Bring-Your-Own-Key) Integration
# You can leave GEMINI_API_KEY blank and configure it securely in-memory via the UI dialog.
# When provided here, it is kept in process memory and never logged or exposed in audit trails.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Sandbox Process Execution & Safety Limits
PATCHPILOT_TARGET_TIMEOUT=30
PATCHPILOT_REGRESSION_TIMEOUT=60
PATCHPILOT_OUTPUT_MAX_BYTES=65536
